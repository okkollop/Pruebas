# Copia este fichero a .env y rellénalo.

# Puerto HTTP del portal (UniFi redirige a http://<IP>/guest/s/<site>/ → debe ser 80)
PORT=80

# --- Consola UniFi (UDM Pro) ---
UNIFI_HOST=192.168.1.1
UNIFI_PORT=443
# Usuario LOCAL (no cuenta Ubiquiti/SSO) con rol limitado, p. ej. "Hotspot Operator"
UNIFI_USER=portal
UNIFI_PASS=cambia-esto
UNIFI_SITE=default
# true para UDM/UDM Pro/UCG/Cloud Key Gen2+ (UniFi OS); false para controlador clásico (puerto 8443)
UNIFI_OS=true
# El UDM usa certificado autofirmado: deja false salvo que tengas uno válido
UNIFI_VERIFY_TLS=false

# --- Condiciones de acceso del huésped ---
# Duración de la autorización en minutos (4320 = 3 días, 10080 = 7 días)
GUEST_MINUTES=4320
# Límites opcionales (0 = sin límite / los del perfil de UniFi)
GUEST_DOWN_KBPS=0
GUEST_UP_KBPS=0
GUEST_MB_LIMIT=0

# Código opcional entregado en recepción (vacío = acceso solo aceptando condiciones)
ACCESS_CODE=

# Registro de huéspedes (JSON Lines). Ojo RGPD: define un plazo de conservación.
GUEST_LOG=./data/guests.jsonl

# true = no llama a UniFi (para probar el diseño)
DRY_RUN=false
